# TeXPresso lexer, written entirely in MuLL.
# Tokens retain their source line and column for diagnostics.
val ASCII <- G:LoadLib("ascii") or G:DieWith("TeXPresso: ascii library unavailable: $E?");
val Space <- fn(c) { return c == " " or c == "\n" or c == "\t" or c == "\r"; };
val Delim <- fn(c) { return Space(c) or c == "(" or c == ")" or c == ";" or c == "'" or c == "\""; };
val Decimal <- fn(s) {
  var i <- 0; var neg <- false;
  if G:Len(s) == 0 { return {ok: false, value: 0}; }
  if s[0] == "-" or s[0] == "+" { neg <- s[0] == "-"; i <- 1; }
  if i == G:Len(s) { return {ok: false, value: 0}; }
  # Classify the entire token before range checking: a long digit prefix
  # does not make a symbol an out-of-range integer literal.
  val start <- i;
  while i < G:Len(s) {
    if not ASCII:IsDigit(s[i]) { return {ok: false, value: 0}; }
    i <- i + 1;
  }
  i <- start;
  var n <- 0;
  while i < G:Len(s) {
    n <- n * 10 + ASCII:Digit(s[i]);
    if n > 2147483647 { G:DieWith("TeXPresso: integer literal exceeds portable TeX bounds"); }
    i <- i + 1;
  }
  if neg { n <- 0 - n; }
  return {ok: true, value: n};
};
val Lex <- fn(source) {
  var out <- []; var i <- 0; var line <- 1; var column <- 1;
  while i < G:Len(source) {
    val c <- source[i];
    if Space(c) {
      if c == "\n" { line <- line + 1; column <- 1; }
      else { column <- column + 1; }
      i <- i + 1;
    } else if c == ";" {
      while i < G:Len(source) and source[i] != "\n" { i <- i + 1; column <- column + 1; }
    } else if c == "(" or c == ")" or c == "'" {
      var k <- "left";
      if c == ")" { k <- "right"; }
      if c == "'" { k <- "quote"; }
      out <- out + [{kind: k, text: c, line: line, column: column}];
      i <- i + 1; column <- column + 1;
    } else if c == "\"" {
      val startline <- line; val startcol <- column;
      i <- i + 1; column <- column + 1;
      var str <- ""; var done <- false;
      while i < G:Len(source) and not done {
        val ch <- source[i];
        if ch == "\"" { done <- true; i <- i + 1; column <- column + 1; }
        else if ch == "\\" {
          i <- i + 1; column <- column + 1;
          if i >= G:Len(source) { G:DieWith("TeXPresso: unterminated string escape"); }
          val esc <- source[i];
          if esc == "n" { str <- str + "\n"; }
          else if esc == "t" { str <- str + "\t"; }
          else if esc == "r" { str <- str + "\r"; }
          else if esc == "\"" { str <- str + "\""; }
          else if esc == "\\" { str <- str + "\\"; }
          else { G:DieWith("TeXPresso: unsupported string escape on line " + G:Str(line)); }
          i <- i + 1; column <- column + 1;
        } else {
          str <- str + ch;
          if ch == "\n" { line <- line + 1; column <- 1; }
          else { column <- column + 1; }
          i <- i + 1;
        }
      }
      if not done { G:DieWith("TeXPresso: unterminated string on line " + G:Str(startline)); }
      out <- out + [{kind: "string", text: str, line: startline, column: startcol}];
    } else {
      val startline <- line; val startcol <- column;
      var s <- "";
      while i < G:Len(source) and not Delim(source[i]) {
        s <- s + source[i]; i <- i + 1; column <- column + 1;
      }
      if G:Len(s) == 0 { G:DieWith("TeXPresso: invalid source character at line " + G:Str(line)); }
      var kind <- "symbol";
      if s == "#t" or s == "#f" { kind <- "boolean"; }
      else {
        val number <- Decimal(s);
        if number:ok { kind <- "integer"; }
      }
      out <- out + [{kind: kind, text: s, line: startline, column: startcol}];
    }
  }
  return out;
};
return {Lex: Lex};
