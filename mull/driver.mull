# TeXPresso entry driver. All parsing, analysis, linking and codegen are MuLL.
# argv encoding: alternating (path, complete-source) pairs followed by entry.
val Analyzer <- G:LoadLib("texpresso_analyzer") or G:DieWith("TeXPresso: analyzer load failed: $E?");
val Codegen <- G:LoadLib("texpresso_codegen") or G:DieWith("TeXPresso: code generator load failed: $E?");
val argc <- G:Len(Args);
if argc < 3 or argc % 2 != 1 {
  G:DieWith("TeXPresso: expected (path source)+ entry in MuLL Args");
}
var files <- [];
var i <- 0;
while i < argc - 1 {
  files <- files + [{path: Args[i], source: Args[i + 1]}];
  i <- i + 2;
}
val program <- Analyzer:Analyze(files);
val body <- Codegen:Emit(program, Args[argc - 1]);
val stdout <- G:GetStdout();
stdout(body);
return nil;
