#!/usr/bin/env python3
"""Thin file-system/CLI bridge for the compiler implemented in MuLL.

No Scheme lexer, parser, analysis, optimization or TeX generation lives here.
MuLL currently lacks a portable file I/O package; sources are passed via Args.
"""
from __future__ import annotations

import argparse
import os
import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def main(argv=None):
    parser = argparse.ArgumentParser(description="TeXPresso: Scheme to plain TeX, powered by MuLL")
    parser.add_argument("sources", nargs="+", type=pathlib.Path, help="Scheme .txp files; include imported modules")
    parser.add_argument("-o", "--output", type=pathlib.Path, help="output TeX program")
    parser.add_argument("--entry", default="main", help="name of an exported zero-argument entry function")
    parser.add_argument("--mull", default=os.environ.get("MULL", "mull"), help="MuLL executable")
    parser.add_argument("--engine", choices=["cpp", "d"], default="cpp", help="MuLL host interpreter")
    parser.add_argument("--tex-engine", default="tex", help="TeX82-compatible engine")
    parser.add_argument("--run", action="store_true", help="execute generated TeX after compilation")
    parser.add_argument("--check-mull", action="store_true", help="check MuLL source without compiling a Scheme program")
    args = parser.parse_args(argv)
    if not shutil.which(args.mull):
        parser.error(f"MuLL executable {args.mull!r} was not found. Build/install mudsl/mull from Chubek/mulib.")
    cmd = [args.mull, f"--engine={args.engine}", "-I", str(ROOT / "mull")]
    if args.check_mull:
        # MuLL's syntax check does not follow LoadLib calls. Check the driver
        # and every compiler package, not just the thin entry point.
        sources = [ROOT / "mull" / "driver.mull", *sorted((ROOT / "mull").glob("*/Package.mull"))]
        for source in sources:
            result = subprocess.call([*cmd, "--check", str(source)])
            if result:
                return result
        return 0
    cmd.append(str(ROOT / "mull" / "driver.mull"))
    cmd.append("--")
    for path in args.sources:
        try:
            data = path.read_bytes()
        except OSError as exc:
            parser.error(str(exc))
        if b"\x00" in data:
            parser.error(f"NUL byte not permitted in Scheme source: {path}")
        if len(data) > 90000:
            parser.error(f"{path} is larger than the per-argument portable limit (90 KB); split into modules")
        if any(byte >= 128 for byte in data):
            parser.error(f"{path}: TeX82 bootstrap supports ASCII source only")
        try:
            source = data.decode("utf-8")
        except UnicodeDecodeError as exc:
            parser.error(f"{path}: invalid UTF-8: {exc}")
        cmd.extend([str(path), source])
    cmd.append(args.entry)
    try:
        completed = subprocess.run(cmd, capture_output=True, text=True, check=False)
    except OSError as exc:
        parser.error(f"unable to execute MuLL: {exc}")
    if completed.returncode != 0:
        sys.stderr.write(completed.stderr or completed.stdout)
        return completed.returncode
    # MuLL emits the linked program body. The bridge only attaches the TeX runtime.
    # This creates a self-contained .tex file (no runtime \input dependencies).
    output = args.output or args.sources[-1].with_suffix(".tex")
    runtime = (ROOT / "runtime" / "tex82.tex").read_text(encoding="utf-8")
    body = completed.stdout
    if not body.lstrip().startswith("% Generated by TeXPresso"):
        sys.stderr.write("TeXPresso: MuLL returned unexpected output instead of generated TeX\n")
        return 2
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(runtime + "\n" + body, encoding="utf-8")
    print(f"TeXPresso: compiled {len(args.sources)} module file(s) to {output}", file=sys.stderr)
    if args.run:
        try:
            result = subprocess.run(
                [args.tex_engine, "-interaction=nonstopmode", "-halt-on-error", output.name],
                cwd=output.resolve().parent,
                check=False,
            )
            return result.returncode
        except OSError as exc:
            print(f"TeXPresso: unable to execute TeX engine: {exc}", file=sys.stderr)
            return 127
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
