(module (demo arith)
  (import (tp base) (tp io))
  (export main)
  (define count 0)
  (define (square x) (* x x))
  (define (increment)
    (set! count (+ count 1)))
  (define (main)
    (println (square 7))
    (increment)
    (increment)
    (println count)
    (println (let* ((x 5) (y (+ x 8))) (* x y)))
    (println (if (and (> 10 2) (zero? 0)) 111 222))))
